@baseUrl = {{$projectUrl}}/api/diagnostico
@usuarioCodigo = LNA
@chaveCache = teste-cache
@valorCache = valor de diagnostico
@chaveDiagnostico =

### Status do diagnostico
GET {{baseUrl}}/status
X-DIAGNOSTICO-CHAVE: {{chaveDiagnostico}}

### Grava um item simples no cache
POST {{baseUrl}}/cache/gravar
Content-Type: application/json
X-DIAGNOSTICO-CHAVE: {{chaveDiagnostico}}

{
  "chave": "{{chaveCache}}",
  "valor": "{{valorCache}}",
  "ttlSegundos": 120
}

### Le o item gravado no cache
GET {{baseUrl}}/cache/ler/{{chaveCache}}
X-DIAGNOSTICO-CHAVE: {{chaveDiagnostico}}

### Remove o item do cache
DELETE {{baseUrl}}/cache/remover/{{chaveCache}}
X-DIAGNOSTICO-CHAVE: {{chaveDiagnostico}}

### Testa gravacao, leitura e remocao do cache em uma unica chamada
POST {{baseUrl}}/cache/testar
Content-Type: application/json
X-DIAGNOSTICO-CHAVE: {{chaveDiagnostico}}

{
  "chave": "teste-cache-autoteste",
  "valor": "valor do autoteste",
  "ttlSegundos": 120
}

### Grava um cookie protegido de diagnostico
POST {{baseUrl}}/cookie/gravar
Content-Type: application/json
X-DIAGNOSTICO-CHAVE: {{chaveDiagnostico}}

{
  "valor": "cookie de diagnostico",
  "minutosExpiracao": 10
}

### Le o cookie protegido de diagnostico
GET {{baseUrl}}/cookie/ler
X-DIAGNOSTICO-CHAVE: {{chaveDiagnostico}}

### Remove o cookie protegido de diagnostico
DELETE {{baseUrl}}/cookie/remover
X-DIAGNOSTICO-CHAVE: {{chaveDiagnostico}}

### Verifica sinais enviados pela requisicao e estado basico do cache
GET {{baseUrl}}/sessao/sinais
XUSRCD: {{usuarioCodigo}}
X-DIAGNOSTICO-CHAVE: {{chaveDiagnostico}}
