{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "atron-web-api",
    "Audience": "atron-audience"
  },
  "Cache": {
    "Provider": "Memory",
    "JsonFile": {
      "Diretorio": "App_Data/cache-json"
    },
    "Redis": {
      "InstanceName": "atron:"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "EmailSettings": {
    "Provider": "Brevo",
    "FromName": "Atron Platform",
    "FromEmail": "",
    "Brevo": {
      "BaseUrl": "https://api.brevo.com/v3"
    }
  }
}
